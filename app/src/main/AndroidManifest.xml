<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Android 11+ package visibility: without this, PackageManager.getPackageInfo("com.google.android.gms", ...)
      in the debug-only DeviceDiagnostics panel (see debug/DeviceDiagnostics.kt) would throw
      NameNotFoundException even when Play services is actually installed, since the target API 36
      manifest opts this app into the filtered-visibility behavior by default. Narrowly scoped to
      the one package this app actually queries - never QUERY_ALL_PACKAGES, which requires a
      separate Play Store policy declaration/review this app has no need for.
    -->
    <queries>
        <package android:name="com.google.android.gms" />
    </queries>

    <!-- Required to subscribe to and read on-device step data via the Recording API, and to
         register the Activity Recognition Transition/Sampling APIs for strict step validation. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- Lets BootAndUpdateReceiver restore motion-evidence registration after a device reboot -
         see that receiver's own doc comment. No location/background-location permission is added
         anywhere in this feature. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      Trip Route Recording (see TripRecordingService): requested only when the user taps "Start
      trip", never on app start. No ACCESS_BACKGROUND_LOCATION - this MVP only records while a
      trip is actively running and explicitly foregrounded via TripRecordingService, never as a
      passive background collector.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Lets the recording notification actually show on API 33+; a denial is handled honestly (see TripsViewModel), never assumed granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".StepSplitApplication"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepSplit">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.StepSplit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Dedicated foreground service for manually recorded GPS trips - entirely separate from
          the WorkManager-driven step-sync pipeline. Not exported: only this app ever starts it,
          always via an explicit Start-trip user action (or the OS restarting an already-running
          instance after process death - see TripRecordingService's own doc comment). There is no
          boot receiver anywhere in this manifest, so a device reboot can never auto-start it.
        -->
        <service
            android:name=".trip.service.TripRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Strict step validation: motion evidence acquisition (see data/motion package). Never
          tied to any Activity's lifecycle - registered once via MotionEvidenceRegistrar and kept
          receiving broadcasts while the UI is fully closed.
        -->
        <receiver
            android:name=".data.motion.MotionEvidenceReceiver"
            android:exported="false" />

        <!--
          Restores motion-evidence registration after a reboot or app update - exported="true" is
          required for these OS-originated broadcasts to ever reach it. There is no other boot
          receiver anywhere in this manifest (the GPS trip feature deliberately has none - see
          TripRecordingService's own doc comment).
        -->
        <receiver
            android:name=".data.motion.BootAndUpdateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          WorkManager's default on-demand initialization is replaced with an explicit
          Configuration.Provider implementation on StepSplitApplication so the periodic
          sync worker can receive a manually-constructed WorkerFactory (manual DI, no
          reflection-based worker construction).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup.InitializationProvider"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
