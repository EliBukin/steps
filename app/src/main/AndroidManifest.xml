<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Health Connect: reads on-device step data written by the platform's own step-counting
      mechanism (see HealthConnectStepSource's own doc comment). No WRITE_STEPS - this app is
      read-only with respect to Health Connect.
    -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!--
      Trip Route Recording (see TripRecordingService): requested only when the user taps "Start
      trip", never on app start. No ACCESS_BACKGROUND_LOCATION - this MVP only records while a
      trip is actively running and explicitly foregrounded via TripRecordingService, never as a
      passive background collector. The Map tab (ui/map/OpenMapScreen.kt) also uses
      location, for its "you are here" dot: asked for when the user taps Allow there, used only
      while that tab is on screen with the app in the foreground, and never stored.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Lets the recording notification actually show on API 33+; a denial is handled honestly (see TripsViewModel), never assumed granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      The maps only (ui/trips/TripRouteMap.kt and ui/map/OpenMapScreen.kt): fetches basemap
      style/vector tiles from OpenFreeMap and hill shading from Mapterhorn (free, keyless tile
      providers - no API key/secret is stored anywhere in this app) while the trip-detail screen or
      the Map tab is visible. No location is ever sent: the requests are for the map's style, fonts
      and tiles only. Never used for background loading - see README's "Map" and "The Map screen"
      sections. The one other request is the Offline maps settings reading the list of map packs
      from the app's GitHub release when they open (data/mappack); the packs themselves download
      through Android's download manager.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".StepSplitApplication"
        android:allowBackup="false"
        tools:ignore="DataExtractionRules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.StepSplit">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.StepSplit">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Importing a GPX route (see MainActivity.routeImportUri and data.route.ImportedRouteRepository):
          "Open with" and Share from another app (Files, a messaging app, email, cloud storage) open
          the Map tab, which reads that one file through the content:// address it was given, with
          the read access that came with it - no storage permission. Only content:// addresses:
          nothing else could be read without one.
          - Open with: the GPX types; and the types apps often give a .gpx they don't know
            (octet-stream, XML, plain text), only when the address ends in .gpx - so the app isn't
            offered for every file of those types. One pattern per number of dots in the path (up to
            five), because Android's pathPattern ".*" stops at the first dot it can match. An address
            without the file's name in it (the Files app's Downloads list, most messaging apps) can't
            match: Share, or Import on the Map tab, gets those files in.
          - Share: the GPX types, plus octet-stream and XML, since messaging and email apps often
            share a .gpx as those (a share's address rarely has the file's name in it). So the app
            also shows in the share sheet for other files of those types; a file that isn't GPX is
            told apart by its content, and nothing is imported.
          The import itself reads the file's content, never trusts the type: see GpxParser.
        -->
        <activity-alias
            android:name=".ui.ImportRouteActivity"
            android:exported="true"
            android:targetActivity=".ui.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/x-gpx+xml" />
                <data android:mimeType="application/x-gpx" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
                <data android:mimeType="text/plain" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.GPX" />
                <data android:pathPattern=".*\\..*\\.GPX" />
                <data android:pathPattern=".*\\..*\\..*\\.GPX" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.GPX" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.GPX" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/x-gpx+xml" />
                <data android:mimeType="application/x-gpx" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
        </activity-alias>

        <!--
          Health Connect requires a screen explaining how this app uses health data, reachable
          from Health Connect's own "App permissions" -> app -> "view usage" flow - see
          PermissionsRationaleActivity's own doc comment. Without both declarations below, Health
          Connect silently refuses to honor a granted READ_STEPS permission at read time.
          The alias (Android 14+) must require android.permission.START_VIEW_PERMISSION_USAGE,
          which Health Connect holds: with any other permission, tapping "privacy policy" in its
          permission screen crashes Health Connect with a SecurityException.
        -->
        <activity
            android:name=".ui.PermissionsRationaleActivity"
            android:exported="true"
            android:theme="@style/Theme.StepSplit.PrivacyPolicy">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".ui.PermissionsRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          The "Save file" entry in the GPX share sheet (see GpxShare and SaveGpxActivity): no
          screen of its own, it opens the system "save as" picker and closes. Not exported - the
          share sheet starts it on this app's behalf.
        -->
        <activity
            android:name=".ui.trips.SaveGpxActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Dedicated foreground service for manually recorded GPS trips - entirely separate from
          the (foreground-only, see SyncScheduler) step-sync pipeline. Not exported: only this app
          ever starts it, always via an explicit Start-trip user action (or the OS restarting an
          already-running instance after process death - see TripRecordingService's own doc
          comment). There is no boot receiver anywhere in this manifest, so a device reboot can
          never auto-start it.
        -->
        <service
            android:name=".trip.service.TripRecordingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!--
          Hands a trip's GPX file to the app the user picks in the share sheet (see GpxShare), as a
          content:// Uri with a one-off read grant. Not exported, and it only serves the shared-GPX
          cache folder listed in gpx_share_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/gpx_share_paths" />
        </provider>

        <!--
          WorkManager's default automatic (ContentProvider/App-Startup-based) initialization is
          replaced with on-demand initialization via a plain Configuration.Provider implementation
          on StepSplitApplication - no custom WorkerFactory is needed for that (there is no longer
          any app-defined Worker class; the only WorkManager call this app makes is a one-off
          cancelUniqueWork on an old, no-longer-scheduled job - see SyncScheduler.cleanUp), but
          on-demand initialization is still required: Robolectric's test environment does not
          reliably run WorkManager's own library-manifest-declared automatic initializer, only the
          Configuration.Provider fallback.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup.InitializationProvider"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
